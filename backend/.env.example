# 이 파일을 복사해 .env 를 만드세요: cp .env.example .env
SECRET_KEY=change-me-to-a-long-random-string-of-50-chars-or-more
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 비워두면 SQLite 사용. PostgreSQL 예시:
# DATABASE_URL=postgres://user:password@localhost:5432/chungnamon
# JWT 만료 설정 (선택)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# 채팅(WebSocket)/캐시를 여러 프로세스에서 공유하려면 Redis 지정 (비우면 메모리 사용, 로컬 개발용)
# REDIS_URL=redis://localhost:6379/0
# 번역: Google Cloud Translation API 키 (없으면 개발용 echo 번역 사용)
# GCP 콘솔 > API 및 서비스 > "Cloud Translation API" 사용 설정 후 사용자 인증 정보에서 API 키 발급
GOOGLE_TRANSLATE_API_KEY=
# AI 챗봇(OpenAI). 없으면 행정 가이드 검색 기반 간이 답변 사용
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# 번역을 OpenAI 로 하려면(기본은 Google): 
# TRANSLATION_BACKEND=apps.translation.backends.OpenAITranslator
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# TRANSLATION_CACHE_TTL_DAYS=30
# 이메일 인증/비밀번호 재설정 메일 (기본: 콘솔 출력)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
